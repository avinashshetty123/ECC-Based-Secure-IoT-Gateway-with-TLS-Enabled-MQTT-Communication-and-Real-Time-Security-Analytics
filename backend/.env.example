# Copy to .env to override defaults. .env is git-ignored.
# Passwords are NOT stored here: scripts\setup_credentials.py generates random
# per-identity passwords into config\secrets\credentials.json (git-ignored).

MQTT_HOST=localhost
# 1884 (not 1883) so we never clash with the Windows "mosquitto" service
MQTT_PORT_PLAIN=1884
MQTT_PORT_TLS=8883
MQTT_PORT_MTLS=8884

DB_PATH=data/iot_gateway.db
LOG_DIR=logs

# OpenSSL CLI used by the certificate script (Git for Windows ships one)
OPENSSL_BIN=C:\Program Files\Git\usr\bin\openssl.exe
MOSQUITTO_DIR=C:\Program Files\mosquitto
