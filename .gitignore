# ---------- Secrets & key material (NEVER commit) ----------
.env
*.key
*.pem
*.p12
*.pfx
*.csr
*.srl
backend/certificates/**
!backend/certificates/.gitkeep
backend/config/passwd
backend/config/passwd.*
backend/config/secrets/
backend/config/*.local.conf

# ---------- Runtime data ----------
backend/data/**
!backend/data/.gitkeep
backend/logs/**
!backend/logs/.gitkeep
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ---------- Python ----------
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
*.egg-info/

# ---------- Frontend (also see frontend/.gitignore) ----------
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/next-env.d.ts

# ---------- Editors / OS ----------
.vscode/*
!.vscode/settings.json
.idea/
Thumbs.db
desktop.ini
.DS_Store
